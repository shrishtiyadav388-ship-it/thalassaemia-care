# Copy to .env, then run node --env-file=.env server.mjs.
# The default server is loopback-only and for development with fictional records.
HOST=127.0.0.1
PORT=4317
APP_ORIGIN=http://127.0.0.1:4317
DATA_DIR=./data
# Required in production: 64 hex characters from a cryptographically random source.
# Keep the key outside Git and back it up separately from the database.
DATA_KEY=
# Required for production registration. Share through a private channel.
REGISTRATION_INVITE=
PRIVACY_CONTACT=
# Only set true after completing RELEASE-CHECKLIST.md with the hosting operator.
PATIENT_RELEASE_REVIEWED=false
# Generated automatically only for local development. Store production keys as host secrets.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A real operator mailto: contact or HTTPS contact URL.
VAPID_SUBJECT=
# Production requires HTTPS APP_ORIGIN and DATA_KEY and REGISTRATION_INVITE.
NODE_ENV=development
